---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { hotel } from '../data/hotel';

interface Props { title?: string; description?: string }
const {
  title = `${hotel.nome} · Hospedagem em ${hotel.cidade}, ${hotel.uf}`,
  description = `Hospedagem em ${hotel.cidade} com check-in até meia-noite, café da manhã e reserva direta. Projeto conceitual.`,
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#22262b" />
    <meta name="robots" content="noindex" /> <!-- protótipo conceitual: não indexar -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <aside class="aviso" aria-label="Aviso do projeto">Projeto conceitual de design. Este não é o site oficial do {hotel.nome}.</aside>
    <Header />
    <main id="conteudo"><slot /></main>
    <Footer />
  </body>
</html>
<style is:global>
  .aviso { background: var(--amarelo); color: var(--asfalto); font: 700 .85rem/1.2 var(--f-texto); text-align: center; padding: .55rem var(--gutter); }
</style>
