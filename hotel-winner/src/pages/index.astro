---
import Base from '../layouts/Base.astro';
import Imagem from '../components/Imagem.astro';
import ReservaForm from '../components/ReservaForm.astro';
import QuartoLinha from '../components/QuartoLinha.astro';
import { hotel, quartos, experiencias } from '../data/hotel';

const nomeQuarto = (id: string) => quartos.find((q) => q.id === id)!.nome;
const compromissos = [
  { t: 'Chegada tardia', d: 'Avise o horário ao reservar. O check-in vai até meia-noite e a recepção espera por você.' },
  { t: 'Pedidos especiais', d: 'Berço, andar, quarto mais silencioso: peça na hora e fica combinado por escrito, antes da viagem.' },
  { t: 'Conversa direta', d: 'Quem responde no WhatsApp é a equipe que vai receber você, sem intermediário.' },
];
---
<Base sobre>
  <!-- HERO -->
  <section class="hero" aria-labelledby="h-hero">
    <div class="hero__bg"><Imagem cena="alvorada" alt="Colinas suaves ao amanhecer no interior paulista" carregar="eager" /></div>
    <div class="hero__veu" aria-hidden="true"></div>
    <p class="legenda-ilus">Imagem ilustrativa</p>
    <div class="hero__txt">
      <h1 id="h-hero">Barretos, sem pressa.</h1>
      <p>Quartos tranquilos, café da manhã e check-in até meia-noite.</p>
    </div>
    <div class="hero__barra"><ReservaForm /></div>
  </section>

  <!-- APRESENTAÇÃO -->
  <section class="section" aria-labelledby="h-intro">
    <div class="container intro">
      <h2 id="h-intro">Um hotel para quem chega depois da estrada e quer acordar sem pressa.</h2>
      <div class="intro__col">
        <p>O {hotel.nome} fica em {hotel.cidade}, no interior de São Paulo. A recepção recebe hóspedes até meia-noite, o café da manhã é continental e a reserva é feita direto com a equipe.</p>
        <dl class="fatos">
          <div><dt>Check-in</dt><dd>{hotel.checkIn}</dd></div>
          <div><dt>Check-out</dt><dd>{hotel.checkOut}</dd></div>
          <div><dt>Café da manhã</dt><dd>{hotel.cafe}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- QUARTOS -->
  <section class="section sec--nevoa" aria-labelledby="h-quartos">
    <div class="container">
      <header class="sec-hd"><h2 id="h-quartos">Quartos</h2><p>Três categorias para quem vem a trabalho, em família ou para a festa.</p></header>
      <div class="lista">{quartos.map((q, i) => <QuartoLinha q={q} inverter={i % 2 === 1} />)}</div>
    </div>
  </section>

  <!-- EXPERIÊNCIAS -->
  <section class="section" id="experiencias" aria-labelledby="h-exp">
    <div class="container">
      <header class="sec-hd"><h2 id="h-exp">Para cada jeito de chegar</h2></header>
      <div class="lista lista--exp">
        {experiencias.map((e, i) => (
          <article class={`exp ${i % 2 === 1 ? 'exp--inv' : ''}`}>
            <div class="exp__img"><Imagem cena={e.cena} foto={e.foto || undefined} alt={e.titulo} /></div>
            <div class="exp__txt">
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
              <ul>{e.dicas.map((d) => <li>{d}</li>)}</ul>
              <a class="btn btn--linha" href="#reserva" data-pedir={e.quarto}>Pedir o quarto {nomeQuarto(e.quarto)}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- RESERVA DIRETA -->
  <section class="section sec--nevoa" id="direto" aria-labelledby="h-direto">
    <div class="container direto">
      <h2 id="h-direto">Reserve direto e combine tudo antes de chegar.</h2>
      <dl class="comp">{compromissos.map((c) => <div><dt>{c.t}</dt><dd>{c.d}</dd></div>)}</dl>
    </div>
  </section>

  <!-- CONTATO -->
  <section class="section escuro contato" aria-labelledby="h-contato">
    <div class="container contato__g">
      <h2 id="h-contato">Fale com a recepção.</h2>
      <address>
        <p class="contato__tel">{hotel.telefone}</p>
        <p>{hotel.email}</p>
        <p>{hotel.endereco}</p>
        <a class="btn" href="#reserva">Pedir reserva</a>
      </address>
    </div>
  </section>
</Base>

<style>
  /* hero: sobe por baixo do cabeçalho transparente */
  .hero { position: relative; margin-top: calc(-1 * var(--hd-h)); min-height: calc(100svh - var(--aviso-h)); padding-top: var(--hd-h); display: grid; grid-template-rows: 1fr auto; overflow: hidden; color: var(--tinta); }
  .hero__bg { position: absolute; inset: 0; }
  .hero__veu { position: absolute; inset: 0; background: linear-gradient(to bottom, rgb(255 255 255 / .22), transparent 30%); }
  .hero__txt { position: relative; z-index: 2; align-self: end; width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; padding: 3rem 0 clamp(2rem, 5vw, 4rem); animation: surge 1.4s var(--ease) both; }
  .hero__txt p { margin: 1.5rem 0 0; font-size: var(--t-lead); font-weight: 300; max-width: 36ch; }
  h1 { max-width: 12ch; font-weight: 250; }
  .hero__barra { position: relative; z-index: 2; width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; padding: 0 0 clamp(1.25rem, 3vw, 2.5rem); }
  @keyframes surge { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: none; } }

  .intro { display: grid; gap: 3rem; }
  .intro h2 { max-width: 20ch; font-size: clamp(2.1rem, 1.2rem + 3.4vw, 4.2rem); }
  .intro__col p { font-size: var(--t-lead); color: var(--tinta-2); font-weight: 300; }
  .fatos { display: grid; gap: 0; margin-top: 2.5rem; border-top: 1px solid var(--tinta); }
  .fatos div { display: grid; grid-template-columns: 9rem 1fr; padding: 1rem 0; border-bottom: 1px solid var(--nevoa-2); }
  .fatos dt { font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--tinta-2); padding-top: .3rem; }
  .fatos dd { font-size: 1.25rem; font-weight: 300; }
  @media (min-width: 62rem) { .intro { grid-template-columns: 1.1fr .9fr; gap: 7rem; } }

  .sec--nevoa { background: var(--nevoa); }
  .sec-hd { display: grid; gap: 1.25rem; margin-bottom: clamp(3rem, 6vw, 5.5rem); } .sec-hd p { margin: 0; font-size: var(--t-lead); font-weight: 300; color: var(--tinta-2); }
  .lista { display: grid; gap: clamp(4rem, 8vw, 8rem); }

  .exp { display: grid; gap: 2rem; align-items: center; }
  .exp__img { aspect-ratio: 16 / 10; overflow: hidden; background: var(--nevoa); }
  .exp__txt { display: grid; gap: 1.25rem; justify-items: start; } .exp__txt p { margin: 0; color: var(--tinta-2); max-width: 44ch; }
  .exp__txt ul { display: grid; gap: .4rem; } .exp__txt li { padding-left: 1.25rem; position: relative; } .exp__txt li::before { content: ''; position: absolute; left: 0; top: .85em; width: .6rem; height: 1px; background: var(--tinta); }
  @media (min-width: 62rem) { .exp { grid-template-columns: 1.3fr .7fr; gap: 6rem; } .exp--inv .exp__img { order: 2; } .exp--inv { grid-template-columns: .7fr 1.3fr; } .exp--inv .exp__txt { order: 1; } }

  .direto { display: grid; gap: 3rem; } .direto h2 { max-width: 14ch; }
  .comp { display: grid; } .comp div { padding-block: 1.75rem; border-top: 1px solid var(--tinta); } .comp div:last-child { border-bottom: 1px solid var(--tinta); }
  .comp dt { font-size: var(--t-h3); font-weight: 250; line-height: 1.1; margin-bottom: .6rem; } .comp dd { color: var(--tinta-2); max-width: 46ch; }
  @media (min-width: 62rem) { .direto { grid-template-columns: 1fr 1fr; gap: 7rem; align-items: start; } }

  .contato { background: var(--noite); color: #fff; }
  .contato__g { display: grid; gap: 3rem; align-items: end; }
  address { font-style: normal; display: grid; gap: .25rem; justify-items: start; } address p { margin: 0 0 .5rem; color: rgb(255 255 255 / .85); }
  .contato__tel { font-size: clamp(2rem, 1.4rem + 2.2vw, 3.2rem); font-weight: 250; color: #fff !important; line-height: 1.1; }
  address .btn { margin-top: 1.5rem; }
  @media (min-width: 62rem) { .contato__g { grid-template-columns: 1.2fr .8fr; gap: 7rem; } }
</style>
