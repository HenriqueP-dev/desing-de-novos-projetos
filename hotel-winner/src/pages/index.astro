---
import Base from '../layouts/Base.astro';
import Imagem from '../components/Imagem.astro';
import HeroVideo from '../components/HeroVideo.astro';
import { temVideoHero } from '../lib/midia';
import ReservaForm from '../components/ReservaForm.astro';
import { hotel, avaliacao, comodidades, distancias } from '../data/hotel';
---
<Base sobre textoClaro={temVideoHero}>
  <!-- HERO -->
  <section class={`hero ${temVideoHero ? 'hero--video' : ''}`} aria-labelledby="h-hero">
    <div class="hero__bg"><HeroVideo alt="Colinas suaves ao amanhecer no interior paulista" /></div>
    <div class="hero__veu" aria-hidden="true"></div>
    <p class="legenda-ilus">{temVideoHero ? 'Vídeo ilustrativo' : 'Imagem ilustrativa'}</p>
    <div class="hero__txt">
      <h1 id="h-hero">Barretos, sem pressa.</h1>
      <p>Café da manhã incluído, Wi-Fi gratuito, estacionamento e piscina.</p>
    </div>
    <div class="hero__barra"><ReservaForm /></div>
  </section>
  <script>
    // Mede a barra de reserva sem mensagens e fixa a altura da 1ª linha da hero.
    // Assim, quando erros aparecem, a barra cresce para baixo e nada acima dela se desloca.
    const hero = document.querySelector<HTMLElement>('.hero');
    const barra = document.querySelector<HTMLElement>('.hero__barra');
    const semMensagens = () => !document.querySelector('.rb .erro:not([hidden]), .rb__resumo:not([hidden])') && !document.querySelector('.rb__msg')?.textContent;
    const medir = () => { if (hero && barra && semMensagens()) hero.style.setProperty('--barra-base', `${barra.offsetHeight}px`); };
    medir(); document.fonts?.ready.then(medir); addEventListener('resize', medir);
  </script>

  <!-- SOBRE O HOTEL -->
  <section class="section" aria-labelledby="h-sobre">
    <div class="container intro">
      <h2 id="h-sobre">Um hotel 2 estrelas em Barretos, bem avaliado por quem já se hospedou.</h2>
      <div class="intro__col">
        <p>O {hotel.nome} fica na {hotel.endereco}, em {hotel.cidade}, no interior de São Paulo. O café da manhã é incluído, o Wi-Fi é gratuito e há estacionamento para os hóspedes.</p>
        <dl class="fatos">
          <div><dt>Categoria</dt><dd>2 estrelas</dd></div>
          <div><dt>Check-in</dt><dd>{hotel.checkIn}</dd></div>
          <div><dt>Check-out</dt><dd>{hotel.checkOut}</dd></div>
          <div><dt>Café da manhã</dt><dd>{hotel.cafe}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ACOMODAÇÕES -->
  <section class="section sec--nevoa" id="acomodacoes" aria-labelledby="h-aco">
    <div class="container aco">
      <div class="aco__img"><Imagem cena="quarto" variante="standard" alt="Quarto claro com cama e janela" /></div>
      <div class="aco__txt">
        <h2 id="h-aco">Acomodações</h2>
        <p>Nas avaliações do Google, os hóspedes elogiam a limpeza dos quartos, o conforto das camas e os bons chuveiros.</p>
        <p class="aco__nota">Categorias de quarto, capacidades e fotos oficiais serão adicionadas depois da confirmação com o hotel. A imagem ao lado é ilustrativa.</p>
        <a class="btn btn--linha" href="/acomodacoes/">Ver acomodações</a>
      </div>
    </div>
  </section>

  <!-- COMODIDADES -->
  <section class="section" id="comodidades" aria-labelledby="h-com">
    <div class="container">
      <header class="sec-hd"><h2 id="h-com">Comodidades</h2></header>
      <ul class="com">{comodidades.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <!-- EXPERIÊNCIA DOS HÓSPEDES -->
  <section class="section sec--nevoa" id="avaliacoes" aria-labelledby="h-av">
    <div class="container av">
      <div class="av__nota">
        <h2 id="h-av" class="sr-only">Experiência dos hóspedes</h2>
        <p class="av__num" aria-label={`Nota ${avaliacao.nota} de 5`}>{avaliacao.nota}</p>
        <p class="av__leg">Nota média no {avaliacao.fonte}, em {avaliacao.total} avaliações.</p>
      </div>
      <div class="av__txt">
        <p class="av__tit" aria-hidden="true">O que os hóspedes mais destacam</p>
        <ul>{avaliacao.elogios.map((e) => <li>{e}</li>)}</ul>
        <p class="av__fonte">Resumo de avaliações públicas do {avaliacao.fonte}. Notas e comentários mudam com o tempo.</p>
      </div>
    </div>
  </section>

  <!-- LOCALIZAÇÃO -->
  <section class="section" id="localizacao" aria-labelledby="h-loc">
    <div class="container loc">
      <div>
        <h2 id="h-loc">Localização</h2>
        <address>
          <p>{hotel.enderecoCompleto}</p>
          <a class="btn btn--linha" href={hotel.mapaLink} target="_blank" rel="noopener">Ver no Google Maps</a>
        </address>
      </div>
      <div>
        <dl class="dist">{distancias.map((d) => <div><dt>{d.lugar}</dt><dd>{d.km}</dd></div>)}</dl>
        <p class="dist__nota">Distâncias aproximadas a partir do hotel.</p>
      </div>
    </div>
  </section>

  <!-- RESERVAS E CONTATO -->
  <section class="section escuro contato" aria-labelledby="h-contato">
    <div class="container contato__g">
      <h2 id="h-contato">Fale com o hotel.</h2>
      <address>
        <p class="contato__tel"><a href={hotel.telefoneLink}>{hotel.telefone}</a></p>
        <p>{hotel.enderecoCompleto}</p>
        <a class="btn" href="#reserva">Pedir reserva</a>
      </address>
    </div>
  </section>
</Base>

<style>
  /* hero: sobe por baixo do cabeçalho transparente */
  .hero { position: relative; margin-top: calc(-1 * var(--hd-h)); padding-top: var(--hd-h); display: grid; grid-template-rows: minmax(calc(100svh - var(--aviso-h) - var(--hd-h) - var(--barra-base, 10rem)), auto) auto; overflow: hidden; color: var(--tinta); }
  .hero__bg { position: absolute; inset: 0; }
  .hero__veu { position: absolute; inset: 0; background: linear-gradient(to bottom, rgb(255 255 255 / .22), transparent 30%); }
  .hero__txt { position: relative; z-index: 2; align-self: end; width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; padding: 3rem 0 clamp(2rem, 5vw, 4rem); animation: surge 1.4s var(--ease) both; }
  .hero__txt p { margin: 1.5rem 0 0; font-size: var(--t-lead); font-weight: 300; max-width: 36ch; }
  h1 { max-width: 12ch; font-weight: 250; }
  .hero__barra { position: relative; z-index: 2; width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; padding: 0 0 clamp(1.25rem, 3vw, 2.5rem); }
  /* com vídeo: texto branco sobre um véu escuro leve (contraste medido em vários quadros) */
  .hero--video { color: #fff; }
  .hero--video .hero__veu { background: linear-gradient(90deg, rgb(8 12 16 / .62), rgb(8 12 16 / .34) 58%, rgb(8 12 16 / .12)), linear-gradient(to bottom, rgb(8 12 16 / .5), transparent 28%, transparent 64%, rgb(8 12 16 / .3)); }
  .hero--video .legenda-ilus { color: #fff; background: rgb(8 12 16 / .75); padding: .4rem .65rem; }
  @keyframes surge { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: none; } }

  .intro { display: grid; gap: 3rem; }
  .intro h2 { max-width: 20ch; font-size: clamp(2.1rem, 1.2rem + 3.4vw, 4.2rem); }
  .intro__col p { font-size: var(--t-lead); color: var(--tinta-2); font-weight: 300; }
  .fatos { display: grid; margin-top: 2.5rem; border-top: 1px solid var(--tinta); }
  .fatos div { display: grid; grid-template-columns: 9rem 1fr; padding: 1rem 0; border-bottom: 1px solid var(--nevoa-2); }
  .fatos dt, .dist dt.rot { font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--tinta-2); padding-top: .3rem; }
  .fatos dd { font-size: 1.25rem; font-weight: 300; }
  @media (min-width: 62rem) { .intro { grid-template-columns: 1.1fr .9fr; gap: 7rem; } }

  .sec--nevoa { background: var(--nevoa); }
  .sec-hd { display: grid; gap: 1.25rem; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }

  .aco { display: grid; gap: 2.5rem; align-items: center; }
  .aco__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--nevoa-2); }
  .aco__txt { display: grid; gap: 1.25rem; justify-items: start; } .aco__txt p { margin: 0; color: var(--tinta-2); max-width: 42ch; font-size: var(--t-lead); font-weight: 300; }
  .aco__txt .aco__nota { font-size: .95rem; font-weight: 400; }
  @media (min-width: 62rem) { .aco { grid-template-columns: 1.15fr .85fr; gap: 6rem; } }

  .com { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--tinta); }
  .com li { padding: 1.4rem 0; border-bottom: 1px solid var(--nevoa-2); font-size: var(--t-h3); font-weight: 250; line-height: 1.1; letter-spacing: -.01em; }
  @media (min-width: 40rem) { .com { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }
  @media (min-width: 62rem) { .com { grid-template-columns: repeat(3, 1fr); } }

  .av { display: grid; gap: 3rem; align-items: center; }
  .av__num { margin: 0; font-size: clamp(7rem, 4rem + 14vw, 16rem); font-weight: 200; line-height: .85; letter-spacing: -.04em; }
  .av__leg { margin: 1rem 0 0; font-size: var(--t-lead); font-weight: 300; color: var(--tinta-2); max-width: 24ch; }
  .av__tit { margin: 0 0 1rem; font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--tinta-2); }
  .av__txt ul { display: grid; border-top: 1px solid var(--tinta); }
  .av__txt li { padding: .85rem 0; border-bottom: 1px solid var(--nevoa-2); font-size: 1.15rem; font-weight: 300; }
  .av__fonte { margin: 1.25rem 0 0; font-size: .875rem; color: var(--tinta-2); }
  @media (min-width: 62rem) { .av { grid-template-columns: .9fr 1.1fr; gap: 7rem; } }

  .loc { display: grid; gap: 3rem; align-items: start; }
  .loc address { font-style: normal; display: grid; gap: 1.25rem; justify-items: start; margin-top: 1.5rem; } .loc address p { margin: 0; color: var(--tinta-2); font-size: var(--t-lead); font-weight: 300; }
  .dist { display: grid; border-top: 1px solid var(--tinta); }
  .dist div { display: grid; grid-template-columns: 1fr auto; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--nevoa-2); align-items: baseline; }
  .dist dt { font-size: 1.15rem; font-weight: 300; } .dist dd { font-size: var(--t-h3); font-weight: 250; line-height: 1; }
  .dist__nota { margin: 1rem 0 0; font-size: .875rem; color: var(--tinta-2); }
  @media (min-width: 62rem) { .loc { grid-template-columns: 1fr 1fr; gap: 7rem; } }

  .contato { background: var(--noite); color: #fff; }
  .contato__g { display: grid; gap: 3rem; align-items: end; }
  address { font-style: normal; }
  .contato address { display: grid; gap: .25rem; justify-items: start; } .contato address p { margin: 0 0 .5rem; color: rgb(255 255 255 / .85); }
  .contato__tel { font-size: clamp(2rem, 1.4rem + 2.2vw, 3.2rem); font-weight: 250; line-height: 1.1; }
  .contato__tel a { color: #fff; text-decoration: none; }
  .contato address .btn { margin-top: 1.5rem; }
  @media (min-width: 62rem) { .contato__g { grid-template-columns: 1.2fr .8fr; gap: 7rem; } }
</style>
