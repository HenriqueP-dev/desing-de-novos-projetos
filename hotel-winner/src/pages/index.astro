---
import Base from '../layouts/Base.astro';
import HeroVideo from '../components/HeroVideo.astro';
import FotoSlot from '../components/FotoSlot.astro';
import Comodidades from '../components/Comodidades.astro';
import ReservaForm from '../components/ReservaForm.astro';
import { temVideoHero } from '../lib/midia';
import { hotel, avaliacao, distancias, apartamentos, cartoes } from '../data/hotel';

// A ideia do site: o hotel é uma base prática para quem chega a Barretos.
// Cada passo usa só fatos do documento do hotel (ou o que os hóspedes elogiam nas avaliações).
const passos = [
  { n: '1', t: 'Chegar', d: `Check-in ${hotel.checkIn}, com estacionamento para os hóspedes.` },
  { n: '2', t: 'Descansar', d: 'Camas confortáveis e bons chuveiros, segundo os hóspedes.' },
  { n: '3', t: 'Tomar café e seguir', d: `Café da manhã incluído. Check-out ${hotel.checkOut}.` },
];
---
<Base>
  <!-- HERO: o vídeo ocupa a primeira tela inteira; título e ação ficam sobre ele, o formulário vem logo abaixo -->
  <section class="hero" aria-labelledby="h-hero">
    <div class="hero__video" data-hero-quadro><HeroVideo /></div>
    <div class="hero__veu" aria-hidden="true"></div>
    <div class="container hero__conteudo">
      <p class="hero__selo">{hotel.categoria} · {hotel.cidade}, {hotel.uf}</p>
      <h1 id="h-hero"><span class="linha"><span data-hero-linha>Chegue, estacione,</span></span> <span class="linha"><span data-hero-linha>descanse.</span></span></h1>
      <div class="hero__lado" data-hero-sub>
        <p class="lead">A {distancias[1].km} do centro de {hotel.cidade}, com estacionamento e café da manhã incluído.</p>
        <div class="hero__acoes">
          <a class="btn" href={hotel.telefoneLink}>Ligar para o hotel</a>
          <a class="link-ouro hero__alt" href="#reserva">ou peça uma reserva abaixo</a>
        </div>
      </div>
    </div>
    <p class="hero__leg">{temVideoHero ? 'Vídeo ilustrativo, não mostra o hotel' : 'Espaço reservado para o vídeo do hotel'}</p>
  </section>
  <div class="reserva-faixa">
    <div class="container hero__barra" data-hero-barra><ReservaForm /></div>
  </div>

  <!-- DO CHECK-IN AO CHECK-OUT: seção densa, em sequência, com as seis comodidades numa faixa -->
  <section class="section sec--champ sec--densa" id="roteiro" aria-labelledby="h-rot">
    <div class="container">
      <h2 id="h-rot">Do check-in ao check-out</h2>
      <ol class="passos num" data-revelar>
        {passos.map((p) => <li><span class="passo__n" aria-hidden="true">{p.n}</span><h3 class="passo__t">{p.t}</h3><p>{p.d}</p></li>)}
      </ol>
      <div id="comodidades" class="com-wrap" data-revelar>
        <h3 class="sr-only">Comodidades</h3>
        <Comodidades linha />
      </div>
    </div>
  </section>

  <!-- ACOMODAÇÕES: as categorias citadas no site antigo do hotel, com as fotos reais recebidas -->
  <section class="section" id="acomodacoes" aria-labelledby="h-aco">
    <div class="container">
      <div class="aco__topo">
        <h2 id="h-aco">Acomodações</h2>
        <p class="lead">Apartamentos duplos, triplos, quádruplos e quíntuplos, com cama box, ar-condicionado, TV de LED com parabólica e frigobar.</p>
      </div>
      <ul class="aco__grade" data-revelar>
        {apartamentos.map((a) => (
          <li>
            <a class="aco__card" href={`/acomodacoes/#${a.id}`}>
              {a.fotos.length > 0
                ? <img src={a.fotos[0].src} alt={a.fotos[0].alt} width="600" height="400" loading="lazy" decoding="async" />
                : <FotoSlot rotulo="" proporcao="3 / 2" aviso="Foto a ser fornecida pelo hotel" />}
              <span class="aco__nome">{a.nome}</span>
              <span class="aco__cap num">Para {a.pessoas} pessoas</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="sec-txt aco__nota">Capacidade pelo nome da categoria e fotos enviadas para o projeto; o hotel ainda vai confirmar capacidade, camas e a categoria de cada foto.</p>
      <a class="btn btn--linha" href="/acomodacoes/">Ver os apartamentos</a>
    </div>
  </section>

  <!-- LOCALIZAÇÃO: a régua de distâncias, a ideia gráfica nascida do conteúdo -->
  <section class="section" id="localizacao" aria-labelledby="h-loc">
    <div class="container loc">
      <div class="loc__txt">
        <h2 id="h-loc">Localização</h2>
        <address>
          <p class="lead">{hotel.enderecoCompleto}</p>
          <a class="btn btn--linha" href={hotel.mapaLink} target="_blank" rel="noopener">Ver no Google Maps</a>
        </address>
      </div>
      <div>
        <ol class="rota num" aria-label="Distâncias a partir do hotel" data-revelar>
          <li class="rota__inicio"><span class="rota__lugar">{hotel.nome}</span><span class="rota__km">ponto de partida</span></li>
          {distancias.map((d) => <li><span class="rota__lugar">{d.lugar}</span><span class="rota__km">{d.km}</span></li>)}
        </ol>
        <p class="sec-txt rota__nota">Distâncias aproximadas a partir do hotel.</p>
      </div>
    </div>
  </section>

  <!-- AVALIAÇÕES: uma frase em escala enorme; abaixo, o que os hóspedes elogiam, por assunto -->
  <section class="section sec--preto sec--grande" id="avaliacoes" aria-labelledby="h-av">
    <div class="container av">
      <h2 id="h-av" class="sr-only">Experiência dos hóspedes</h2>
      <p class="mega num" data-revelar>Em {avaliacao.total} avaliações no {avaliacao.fonte}, a nota média é <span class="mega__nota">{avaliacao.nota}</span>.</p>
      <div class="temas" data-revelar>
        {avaliacao.temas.map((t) => (
          <div class="tema"><h3 class="tema__t">{t.titulo}</h3><ul>{t.itens.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
      <p class="sec-txt av__fonte">Resumo das avaliações públicas do {avaliacao.fonte}, não são citações literais. Notas e comentários mudam com o tempo.</p>
    </div>
  </section>

  <!-- CONTATO: só o canal que existe, o telefone -->
  <section class="section sec--champ contato" aria-labelledby="h-contato">
    <div class="container contato__g">
      <div>
        <h2 id="h-contato">Fale com o hotel.</h2>
        <p class="lead">Para reservas e informações, ligue para a recepção.</p>
      </div>
      <address class="contato__dados">
        <a class="contato__tel num" href={hotel.telefoneLink}>{hotel.telefone}</a>
        <p class="sec-txt">{hotel.enderecoCompleto}</p>
        <p class="sec-txt contato__cartoes">Cartões: {cartoes.join(', ')}.</p>
        <div class="contato__acoes">
          <a class="btn" href={hotel.telefoneLink}>Ligar para o hotel</a>
          <a class="btn btn--linha" href="#reserva">Pedir reserva</a>
        </div>
      </address>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero: vídeo em tela cheia ---------- */
  .hero { position: relative; display: grid; align-items: end; min-height: max(32rem, calc(100svh - 7.5rem)); overflow: hidden; background: #000; color: #fff; }
  .hero__video { position: absolute; inset: 0; }
  .hero__veu { position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / .8), rgb(0 0 0 / .4) 55%, rgb(0 0 0 / .18)); }
  .hero__conteudo { position: relative; z-index: 1; padding-block: 3rem clamp(3rem, 6vw, 4.5rem); display: grid; gap: 1.5rem; }
  .hero__selo { margin: 0; font: 500 var(--t-mini)/1 var(--f-texto); letter-spacing: .06em; color: var(--ouro); }
  .hero h1 { color: #fff; max-width: 14ch; }
  .linha { display: block; overflow: hidden; padding-bottom: .06em; }
  .linha > span { display: block; }
  .hero__lado { display: grid; gap: 1.5rem; max-width: 34rem; }
  .hero__lado .lead { margin: 0; color: rgb(255 255 255 / .95); font-weight: 400; }
  .hero__acoes { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.5rem; }
  .hero__alt { font-size: .95rem; color: #fff; }
  .hero__leg { position: absolute; z-index: 1; right: var(--gutter); top: 1rem; margin: 0; padding: .35rem .7rem; font-size: .8rem; line-height: 1.2; color: #fff; background: rgb(0 0 0 / .6); border-radius: var(--raio); max-width: none; }
  .reserva-faixa { padding-block: clamp(2rem, 4vw, 3rem); background: var(--creme); border-bottom: 1px solid var(--areia); }
  @media (max-width: 61.99rem) { .hero { min-height: max(30rem, calc(100svh - 12.5rem)); } }
  @media (min-width: 62rem) { .hero h1 { max-width: none; } }

  /* ---------- seções com densidades diferentes ---------- */
  .sec--densa { padding-block: clamp(3.5rem, 6vw, 5.5rem); }
  .sec--grande { padding-block: clamp(4.5rem, 9vw, 8rem); }

  /* ---------- do check-in ao check-out ---------- */
  .passos { position: relative; display: grid; gap: 0; margin-top: clamp(2rem, 4vw, 3rem); }
  .passos li { position: relative; display: grid; gap: .35rem; padding: 0 0 1.75rem 2.25rem; }
  .passos::before { content: ''; position: absolute; left: .27rem; top: .55rem; bottom: 1.5rem; width: 3px; background: var(--ouro); }
  .passos li::before { content: ''; position: absolute; left: 0; top: .5rem; width: .65rem; height: .65rem; border-radius: 50%; background: var(--champ); border: 2px solid var(--grafite); }
  .passo__n { font: 400 .8rem var(--f-texto); letter-spacing: .15em; color: var(--ouro-texto); }
  .passo__t { font: 400 clamp(1.6rem, 1.3rem + 1vw, 2.1rem)/1.1 var(--f-titulo); }
  .passos p { margin: 0; color: var(--marrom); max-width: 30ch; }
  .com-wrap { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  @media (min-width: 62rem) {
    .passos { grid-template-columns: repeat(3, 1fr); column-gap: 3rem; }
    .passos::before { left: .32rem; right: 0; top: .26rem; bottom: auto; width: auto; height: 3px; }
    .passos li { padding: 2rem 0 0 0; }
    .passos li::before { top: 0; }
    .passos li:first-child::before { background: var(--ouro); }
  }

  /* ---------- acomodações ---------- */
  .aco__topo { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .aco__topo .lead { margin: 0; max-width: 46ch; }
  @media (min-width: 62rem) { .aco__topo { grid-template-columns: 1fr 1fr; align-items: end; gap: 6rem; } }
  .aco__grade { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 1rem; margin-bottom: 1.5rem; }
  @media (min-width: 62rem) { .aco__grade { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }
  .aco__card { display: grid; gap: .35rem; text-decoration: none; }
  .aco__card img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--raio); background: var(--areia); }
  .aco__card :global(.fs) { width: 100%; }
  .aco__nome { margin-top: .5rem; font: 400 clamp(1.5rem, 1.2rem + 1vw, 2rem)/1.1 var(--f-titulo); }
  .aco__cap { font-size: .95rem; color: var(--marrom); }
  .aco__nota { margin: 0 0 1.75rem; font-size: .9rem; max-width: 62ch; }
  @media (hover: hover) { .aco__card img { transition: filter .5s var(--ease); } .aco__card:hover img { filter: brightness(.94); } .aco__card:hover .aco__nome { text-decoration: underline; text-decoration-color: var(--ouro); text-decoration-thickness: 3px; text-underline-offset: .2em; } }

  /* ---------- localização ---------- */
  .loc { display: grid; gap: 3rem; align-items: start; }
  .loc address { font-style: normal; display: grid; gap: 1.5rem; justify-items: start; margin-top: 1.75rem; }
  .loc address .lead { margin: 0; }
  .rota { position: relative; display: grid; }
  .rota::before { content: ''; position: absolute; left: .36rem; top: 1.9rem; bottom: 1.9rem; width: 3px; background: var(--ouro); }
  .rota li { position: relative; display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 1rem; padding: 1.25rem 0 1.25rem 2.25rem; border-bottom: 1px solid var(--areia); }
  .rota li::before { content: ''; position: absolute; left: .1rem; top: 50%; width: .62rem; height: .62rem; margin-top: -.31rem; border-radius: 50%; background: var(--off); border: 2px solid var(--grafite); }
  .rota .rota__inicio::before { background: var(--ouro); }
  .rota__lugar { font-size: 1.0625rem; }
  .rota__km { font: 400 clamp(1.5rem, 1.2rem + 1vw, 2rem)/1 var(--f-titulo); }
  .rota__inicio .rota__km { font: 400 .875rem var(--f-texto); color: var(--marrom); }
  .rota__nota { margin: 1rem 0 0; font-size: .875rem; }
  @media (min-width: 62rem) { .loc { grid-template-columns: .9fr 1.1fr; gap: 7rem; } }

  .sec--preto { background: #000; color: #fff; }
  /* ---------- avaliações: uma frase enorme, sem rótulo e sem bloco de estatística ---------- */
  .av { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .mega { margin: 0; max-width: 20ch; font: 400 clamp(2.6rem, 1.1rem + 6.4vw, 6.75rem)/1.02 var(--f-titulo); font-variation-settings: 'opsz' 28; letter-spacing: -.03em; text-wrap: balance; }
  .mega__nota { color: var(--ouro); }
  .temas { display: grid; gap: 2rem; border-top: 3px solid var(--ouro); padding-top: 1.75rem; }
  .tema__t { font: 500 .7rem/1 var(--f-texto); letter-spacing: .2em; text-transform: uppercase; color: var(--ouro); margin-bottom: .9rem; }
  .tema li { padding: .5rem 0; font: 400 1.3rem/1.25 var(--f-titulo); }
  .av__fonte { margin: -1rem 0 0; font-size: .875rem; color: #c4c4c4; }
  @media (min-width: 52rem) { .temas { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }

  /* ---------- contato ---------- */
  .contato__g { display: grid; gap: 3rem; align-items: end; }
  .contato__g .lead { margin: 1.25rem 0 0; }
  .contato__dados { font-style: normal; display: grid; gap: .5rem; justify-items: start; }
  .contato__tel { display: inline-block; min-height: 2.75rem; padding-block: .25rem; font: 400 clamp(2.4rem, 1.6rem + 3vw, 4.25rem)/1.05 var(--f-titulo); text-decoration: none; letter-spacing: -.02em; }
  @media (hover: hover) { .contato__tel { transition: color .3s var(--ease); } .contato__tel:hover { color: var(--ouro-texto); } }
  .contato__dados .sec-txt { margin: .25rem 0 .25rem; }
  .contato__dados .contato__cartoes { margin-bottom: 1.25rem; font-size: .95rem; }
  .contato__acoes { display: flex; flex-wrap: wrap; gap: .9rem; }
  @media (min-width: 62rem) { .contato__g { grid-template-columns: 1fr 1fr; gap: 7rem; } }
</style>
