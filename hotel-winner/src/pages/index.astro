---
import Base from '../layouts/Base.astro';
import Placa from '../components/Placa.astro';
import QuartosLista from '../components/QuartosLista.astro';
import Motivos from '../components/Motivos.astro';
import { hotel } from '../data/hotel';

const compromissos = [
  { t: 'Chegada tardia', d: 'Avise o horário ao reservar. O check-in vai até meia-noite e a recepção espera por você.' },
  { t: 'Pedidos especiais', d: 'Berço, andar, quarto mais silencioso: peça na hora e fica combinado por escrito, antes da viagem.' },
  { t: 'Conversa direta', d: 'Quem responde no WhatsApp é a equipe que vai receber você, sem intermediário.' },
];
---
<Base>
  <!-- HERO -->
  <section class="hero" aria-labelledby="h-hero">
    <div class="container hero__grid">
      <div class="hero__txt">
        <h1 id="h-hero">Chegou tarde? A gente espera até meia-noite.</h1>
        <p class="hero__lead">Hospedagem em Barretos com check-in das 13h às 24h, café da manhã continental e reserva direta com o hotel.</p>
        <a class="btn btn--contorno" href="#quartos">Ver os quartos</a>
      </div>
      <Placa />
    </div>
  </section>

  <!-- QUARTOS -->
  <section class="section" id="quartos" aria-labelledby="h-quartos">
    <div class="container">
      <header class="sec-hd">
        <h2 id="h-quartos">Escolha o quarto</h2>
        <p>Abra um quarto para ver os detalhes e peça direto, já com ele escolhido na reserva.</p>
      </header>
      <QuartosLista />
    </div>
  </section>

  <!-- RESERVA DIRETA -->
  <section class="section escuro direto" id="direto" aria-labelledby="h-direto">
    <div class="container direto__grid">
      <h2 id="h-direto">Reserve direto e combine tudo antes de chegar.</h2>
      <dl class="comp">
        {compromissos.map((c) => (<div class="comp__i"><dt>{c.t}</dt><dd>{c.d}</dd></div>))}
      </dl>
    </div>
  </section>

  <!-- MOTIVO DA VIAGEM -->
  <section class="section" id="motivo" aria-labelledby="h-motivo">
    <div class="container">
      <header class="sec-hd">
        <h2 id="h-motivo">Você vem para quê?</h2>
        <p>Escolha o motivo da viagem e veja o que mais ajuda quem chega a Barretos.</p>
      </header>
      <Motivos />
    </div>
  </section>

  <!-- CONTATO -->
  <section class="contato" id="contato" aria-labelledby="h-contato">
    <div class="container contato__grid">
      <h2 id="h-contato">Fale com a recepção.</h2>
      <address>
        <p><span class="rotulo">Telefone</span><br /><span class="contato__tel">{hotel.telefone}</span></p>
        <p><span class="rotulo">E-mail</span><br />{hotel.email}</p>
        <p><span class="rotulo">Endereço</span><br />{hotel.endereco}</p>
        <a class="btn btn--acao" href="#reserva">Pedir reserva</a>
      </address>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3.5rem, 7vw, 6.5rem); }
  .hero__grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  .hero__txt { display: grid; gap: 1.75rem; justify-items: start; }
  .hero__lead { margin: 0; font-size: var(--t-lead); max-width: 34ch; }
  @media (min-width: 64rem) { .hero__grid { grid-template-columns: 1.15fr .85fr; gap: 4rem; } }

  .sec-hd { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .sec-hd p { margin: 0; font-size: var(--t-lead); max-width: 46ch; color: var(--texto-2); }

  .direto { background: var(--asfalto); color: var(--cal); }
  .direto__grid { display: grid; gap: 3rem; }
  .direto h2 { max-width: 14ch; }
  .comp { margin: 0; display: grid; }
  .comp__i { padding-block: 1.75rem; border-top: 4px dashed var(--amarelo); }
  .comp__i:last-child { border-bottom: 4px dashed var(--amarelo); }
  .comp dt { font: 700 var(--t-h3)/1 var(--f-sinal); text-transform: uppercase; color: var(--amarelo); margin-bottom: .6rem; }
  .comp dd { margin: 0; max-width: 46ch; }
  @media (min-width: 60rem) { .direto__grid { grid-template-columns: 1fr 1fr; gap: 6rem; align-items: start; } }

  .contato { background: var(--cal-2); padding-block: var(--sec); }
  .contato__grid { display: grid; gap: 2.5rem; align-items: end; }
  address { font-style: normal; display: grid; gap: 1.1rem; justify-items: start; }
  address p { margin: 0; }
  .contato__tel { font: 800 clamp(2.2rem, 1.6rem + 2.4vw, 3.4rem)/1 var(--f-sinal); }
  @media (min-width: 52rem) { .contato__grid { grid-template-columns: 1.2fr .8fr; gap: 6rem; } }
</style>
