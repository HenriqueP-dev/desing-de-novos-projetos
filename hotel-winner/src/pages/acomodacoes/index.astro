---
import Base from '../../layouts/Base.astro';
import FotoSlot from '../../components/FotoSlot.astro';
import Comodidades from '../../components/Comodidades.astro';
import ReservaForm from '../../components/ReservaForm.astro';
import { hotel, apartamentos, equipamentosApto, cartoes } from '../../data/hotel';

const emDefinicao = [
  'Categoria "individual": a página de apartamentos do hotel não a cita',
  'Capacidade e camas de cada categoria, e quantos apartamentos há de cada tipo',
  'Fotos de todas as categorias e a que categoria cada foto corresponde',
  'Valores das diárias',
  'Política de cancelamento',
  'Regras para crianças e animais de estimação',
];
---
<Base title="Acomodações · Hotel Winner" description="Apartamentos duplos, triplos, quádruplos e quíntuplos do Hotel Winner, em Barretos, com cama box, ar-condicionado, TV de LED com parabólica e frigobar. Projeto conceitual.">
  <section class="section topo" aria-labelledby="h-a">
    <div class="container topo__g">
      <h1 id="h-a">Acomodações</h1>
      <p class="lead">Apartamentos duplos, triplos, quádruplos e quíntuplos, com cama box, ar-condicionado, TV de LED com parabólica e frigobar.</p>
    </div>
  </section>

  <!-- Equipamentos comuns, antes das categorias -->
  <section class="sec--champ sec--densa" aria-labelledby="h-eq">
    <div class="container eq">
      <div>
        <h2 id="h-eq">Em todos os apartamentos</h2>
        <p class="sec-txt eq__fonte">Conforme a página de apartamentos do site do hotel.</p>
      </div>
      <ul class="eq__lista" data-revelar>{equipamentosApto.map((e) => <li>{e}</li>)}</ul>
    </div>
  </section>

  <!-- Uma composição editorial por categoria; só entra foto real, o resto assume a falta -->
  <section class="section" aria-labelledby="h-cat">
    <div class="container">
      <h2 id="h-cat" class="sr-only">Categorias de apartamento</h2>
      <p class="sec-txt nota">A página do hotel reúne todas as fotos num só carrossel, sem dizer a que categoria cada uma pertence. Aqui, a capacidade segue o nome da categoria e cada foto foi posta junto da categoria pelo número de camas que aparece nela; o hotel ainda vai confirmar essa associação. As legendas descrevem só o que se vê.</p>
      {apartamentos.map((a, i) => (
        <article class:list={['cat', i % 2 === 1 && 'cat--inv']} id={a.id} aria-labelledby={`h-${a.id}`}>
          <div class="cat__fotos">
            {a.fotos.length > 0 ? (
              <>
                <figure class="cat__foto cat__foto--principal" data-revelar-foto>
                  <img src={a.fotos[0].src} alt={a.fotos[0].alt} loading="lazy" decoding="async" />
                  <figcaption>{a.fotos[0].legenda}</figcaption>
                </figure>
                {a.fotos.length > 1 && (
                  <div class="cat__mais">
                    {a.fotos.slice(1).map((f) => (
                      <figure class="cat__foto" data-revelar-foto>
                        <img src={f.src} alt={f.alt} loading="lazy" decoding="async" />
                        <figcaption>{f.legenda}</figcaption>
                      </figure>
                    ))}
                  </div>
                )}
              </>
            ) : (
              <FotoSlot rotulo={`Apartamento ${a.nome}`} proporcao="3 / 2" aviso="Foto a ser fornecida pelo hotel" />
            )}
          </div>
          <div class="cat__txt">
            <p class="cat__n num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 id={`h-${a.id}`}>Apartamento {a.nome}</h3>
            <p class="cat__cap num">Para {a.pessoas} pessoas</p>
            <p class="sec-txt">Cama box, ar-condicionado, TV de LED com parabólica, frigobar e banheiro com box blindex, como nos demais apartamentos.</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section sec--champ corpo" aria-labelledby="h-no">
    <div class="container corpo__g">
      <h2 id="h-no">No hotel</h2>
      <div>
        <Comodidades compacta />
        <dl class="horas num">
          <div><dt>Check-in</dt><dd>{hotel.checkIn}</dd></div>
          <div><dt>Check-out</dt><dd>{hotel.checkOut}</dd></div>
          <div><dt>Cartões</dt><dd class="horas__cartoes">{cartoes.join(', ')}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-d">
    <div class="container corpo__g">
      <h2 id="h-d">Em definição com o hotel</h2>
      <div>
        <p class="sec-txt">Estas informações ainda não foram confirmadas, por isso o site não as apresenta.</p>
        <ul class="lista">{emDefinicao.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section sec--champ" aria-labelledby="h-r">
    <div class="container reserva"><h2 id="h-r">Peça a sua reserva</h2><ReservaForm /></div>
  </section>
</Base>
<style>
  .topo { padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .topo__g { display: grid; gap: 1.5rem; }
  .topo__g .lead { margin: 0; max-width: 46ch; }
  @media (min-width: 62rem) { .topo__g { grid-template-columns: 1fr 1fr; align-items: end; gap: 6rem; } }

  .sec--densa { padding-block: clamp(3rem, 6vw, 4.5rem); }
  .eq { display: grid; gap: 2rem; align-items: start; }
  .eq__fonte { margin: .75rem 0 0; font-size: .9rem; max-width: 32ch; }
  .eq__lista { display: grid; grid-template-columns: 1fr; border-top: 3px solid var(--ouro); }
  .eq__lista li { padding: .85rem 0 .85rem 1.75rem; border-bottom: 1px solid var(--areia); position: relative; font: 400 1.25rem/1.3 var(--f-titulo); }
  .eq__lista li::before { content: ''; position: absolute; left: 0; top: 50%; width: .5rem; height: .5rem; margin-top: -.45rem; background: var(--ouro); border: 2px solid var(--grafite); border-radius: 50%; box-sizing: content-box; }
  @media (min-width: 40rem) { .eq__lista { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }
  @media (min-width: 62rem) { .eq { grid-template-columns: .8fr 1.2fr; gap: 6rem; } }

  .nota { margin: 0 0 clamp(2.5rem, 5vw, 4rem); font-size: .9rem; max-width: 60ch; }
  .cat { display: grid; gap: 1.5rem; padding-block: clamp(2rem, 4vw, 3rem); border-top: 1px solid var(--areia); }
  .cat__fotos { display: grid; gap: .75rem; }
  .cat__foto { position: relative; margin: 0; overflow: hidden; border-radius: var(--raio); background: var(--areia); }
  .cat__foto img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .cat__foto figcaption { padding: .6rem 0 0; font-size: .85rem; line-height: 1.4; color: var(--marrom); background: var(--off); }
  .cat__mais { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .cat__txt { display: grid; gap: .6rem; align-content: start; }
  .cat__txt .sec-txt { margin: .5rem 0 0; max-width: 36ch; }
  .cat__n { margin: 0; font: 500 .8rem var(--f-texto); letter-spacing: .15em; color: var(--ouro-texto); }
  .cat__txt h3 { font-size: clamp(2rem, 1.4rem + 2vw, 3rem); }
  .cat__cap { margin: 0; font: 400 1.25rem var(--f-titulo); }
  @media (min-width: 62rem) {
    .cat { grid-template-columns: 1.35fr .65fr; gap: 5rem; align-items: start; }
    .cat--inv { grid-template-columns: .65fr 1.35fr; }
    .cat--inv .cat__fotos { order: 2; }
    .cat__txt { position: sticky; top: calc(var(--hd-h) + 2rem); }
  }
  @media (hover: hover) { .cat__foto img { transition: transform .8s var(--ease-out); } .cat__foto:hover img { transform: scale(1.03); } }

  .corpo__g { display: grid; gap: 2.5rem; }
  @media (min-width: 62rem) { .corpo__g { grid-template-columns: .8fr 1.2fr; gap: 7rem; } }
  .horas { margin-top: 2rem; }
  .horas div { display: grid; grid-template-columns: 9rem 1fr; align-items: baseline; padding: .8rem 0; }
  .horas dt { font-size: .7rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--marrom); }
  .horas dd { font: 400 1.25rem var(--f-titulo); }
  .horas .horas__cartoes { font-size: 1.1rem; }
  .lista { display: grid; margin-top: 1.5rem; border-top: 1px solid var(--grafite); }
  .lista li { padding: .9rem 0; border-bottom: 1px solid var(--areia); font: 400 1.25rem/1.3 var(--f-titulo); }
  .reserva { display: grid; gap: 2.5rem; }
</style>
