---
import Base from '../../layouts/Base.astro';
import Imagem from '../../components/Imagem.astro';
import ReservaForm from '../../components/ReservaForm.astro';
import { hotel, comodidades, pendencias } from '../../data/hotel';
const emDefinicao = ['Categorias e quantidade de quartos', 'Capacidade de cada quarto', 'Fotos oficiais dos quartos', 'Valores das diárias', 'Política de cancelamento', 'Regras para crianças e animais de estimação'];
---
<Base title="Acomodações · Hotel Winner" description="Acomodações do Hotel Winner, em Barretos. Projeto conceitual.">
  <section class="section" aria-labelledby="h-a">
    <div class="container">
      <header class="topo">
        <h1 id="h-a">Acomodações</h1>
        <p>Nas avaliações do Google, os hóspedes elogiam a limpeza dos quartos, o conforto das camas e os bons chuveiros.</p>
      </header>
      <div class="corpo">
        <div class="corpo__img"><Imagem cena="quarto" variante="standard" alt="Quarto claro com cama e janela" /></div>
        <div class="corpo__txt">
          <h2>No hotel</h2>
          <ul class="lista">{comodidades.map((c) => <li>{c}</li>)}</ul>
          <dl class="fatos">
            <div><dt>Check-in</dt><dd>{hotel.checkIn}</dd></div>
            <div><dt>Check-out</dt><dd>{hotel.checkOut}</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>
  <section class="section sec--nevoa" aria-labelledby="h-d">
    <div class="container def">
      <h2 id="h-d">Em definição com o hotel</h2>
      <div>
        <p>Estas informações ainda não foram confirmadas, por isso o site não as apresenta. A imagem desta página é ilustrativa.</p>
        <ul class="lista">{emDefinicao.map((c) => <li>{c}</li>)}</ul>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="h-r">
    <div class="container reserva"><h2 id="h-r">Peça a sua reserva</h2><ReservaForm /></div>
  </section>
</Base>
<style>
  h1 { font-size: clamp(3rem, 1.2rem + 7vw, 7rem); }
  .topo { display: grid; gap: 1.25rem; margin-bottom: clamp(3rem, 6vw, 5.5rem); } .topo p { margin: 0; font-size: var(--t-lead); font-weight: 300; color: var(--tinta-2); }
  .corpo { display: grid; gap: 2.5rem; align-items: start; }
  .corpo__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--nevoa); }
  .corpo__txt { display: grid; gap: 1.5rem; } .corpo__txt h2, .def h2 { font-size: var(--t-h3); }
  .lista { display: grid; border-top: 1px solid var(--tinta); } .lista li { padding: .75rem 0; border-bottom: 1px solid var(--nevoa-2); font-weight: 300; font-size: 1.15rem; }
  .fatos { display: grid; margin-top: .5rem; } .fatos div { display: grid; grid-template-columns: 9rem 1fr; padding: .6rem 0; }
  .fatos dt { font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--tinta-2); padding-top: .3rem; } .fatos dd { font-size: 1.15rem; font-weight: 300; }
  .sec--nevoa { background: var(--nevoa); } .def { display: grid; gap: 2rem; } .def p { color: var(--tinta-2); max-width: 46ch; }
  .reserva { display: grid; gap: 2.5rem; }
  @media (min-width: 62rem) { .corpo { grid-template-columns: 1.2fr .8fr; gap: 6rem; } .def { grid-template-columns: .8fr 1.2fr; gap: 6rem; } }
</style>
