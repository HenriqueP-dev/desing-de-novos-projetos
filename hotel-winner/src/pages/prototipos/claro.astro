---
// Direção 1 · CLARO E MINIMALISTA (lógica da Casa Angelina): ar, branco, silêncio, foto manda.
import '@fontsource-variable/jost';
import Proto from '../../layouts/Proto.astro';
import Imagem from '../../components/Imagem.astro';
import ReservaBarra from '../../components/ReservaBarra.astro';
---
<Proto title="Protótipo 1 · Claro · Hotel Winner">
  <section class="hero">
    <div class="bg"><Imagem cena="alvorada" alt="Colinas suaves ao amanhecer no interior paulista" /></div>
    <div class="veu" aria-hidden="true"></div>
    <header class="nav">
      <nav class="nav__l" aria-label="Principal"><a href="#">Quartos</a><a href="#">Experiências</a></nav>
      <a class="marca" href="#"><span class="marca__n">Hotel Winner</span><span class="marca__l">Barretos</span></a>
      <nav class="nav__r" aria-label="Secundário"><a href="#">Contato</a><a class="nav__cta" href="#reserva">Reservar</a></nav>
    </header>
    <p class="legenda-ilus">Imagem ilustrativa</p>
    <div class="txt">
      <h1>Barretos, sem pressa.</h1>
      <p>Café da manhã incluído, Wi-Fi gratuito, estacionamento e piscina.</p>
    </div>
    <div class="barra" id="reserva"><ReservaBarra /></div>
  </section>
  <p class="sr-only"><a href="/prototipos/">Voltar aos protótipos</a></p>
</Proto>
<style is:global>
  body { font-family: 'Jost Variable', system-ui, sans-serif; background: #fff; color: #0d1820; } .legenda-ilus { color: rgb(13 24 32 / .75) !important; }
</style>
<style>
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; --rb-bg: rgb(255 255 255 / .96); --rb-fg: #1b2a35; --rb-linha: rgb(27 42 53 / .22); --rb-btn-bg: #1b2a35; --rb-btn-fg: #fff; --rb-fonte: 'Jost Variable', sans-serif; }
  .bg { position: absolute; inset: 0; }
  .veu { position: absolute; inset: 0; background: linear-gradient(to bottom, rgb(255 255 255 / .22), transparent 30%); }
  .nav { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 1.5rem clamp(1.25rem, 4vw, 3.5rem); font-size: .78rem; letter-spacing: .22em; text-transform: uppercase; }
  .nav a { text-decoration: none; padding: .5rem 0; } .nav__l, .nav__r { display: flex; gap: 2rem; } .nav__r { justify-content: flex-end; align-items: center; }
  .nav__cta { border: 1px solid #0d1820; padding: .7rem 1.4rem !important; }
  .marca { display: grid; justify-items: center; gap: .3rem; }
  .marca__n { font-size: 1.15rem; letter-spacing: .38em; font-weight: 300; } .marca__l { font-size: .62rem; letter-spacing: .5em; opacity: .85; }
  .txt { position: relative; z-index: 2; align-self: end; padding: 0 clamp(1.25rem, 4vw, 3.5rem) clamp(2rem, 5vw, 4rem); }
  h1 { margin: 0 0 1.75rem; font-weight: 250; font-size: clamp(3.2rem, 1rem + 9vw, 9.5rem); line-height: .98; letter-spacing: -.02em; max-width: 12ch; text-wrap: balance; }
  .txt p { margin: 0; font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); font-weight: 300; max-width: 36ch; }
  .barra { position: relative; z-index: 2; padding: 0 clamp(1.25rem, 4vw, 3.5rem) clamp(1.25rem, 3vw, 2.5rem); }
  @media (max-width: 62rem) { .nav { grid-template-columns: 1fr auto; } .nav__l, .nav__r a:not(.nav__cta) { display: none; } .marca { grid-column: 1; justify-items: start; grid-row: 1; } .nav__r { grid-column: 2; grid-row: 1; } }
</style>
