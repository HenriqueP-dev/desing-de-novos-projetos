---
// Direção 3 · ESCURO E URBANO (lógica do One&Only): noite, vidro escuro, uma luz quente. Aqui a luz acesa É a ideia.
import '@fontsource-variable/jost';
import Proto from '../../layouts/Proto.astro';
import Imagem from '../../components/Imagem.astro';
import ReservaBarra from '../../components/ReservaBarra.astro';
---
<Proto title="Protótipo 3 · Escuro · Hotel Winner">
  <section class="hero">
    <div class="bg"><Imagem cena="estrada" alt="Estrada à noite com o hotel aceso ao fundo" /></div>
    <div class="veu" aria-hidden="true"></div>
    <header class="nav">
      <a class="marca" href="#">Winner</a>
      <nav aria-label="Principal"><a href="#">Quartos</a><a href="#">Experiências</a><a class="cta" href="#reserva">Reservar</a></nav>
    </header>
    <p class="legenda-ilus">Imagem ilustrativa</p>
    <div class="conteudo">
      <p class="hora"><span data-agora>agora em Barretos</span></p>
      <h1>Sempre uma luz acesa.</h1>
      <p class="sub">Check-in até meia-noite. A recepção espera você chegar.</p>
    </div>
    <div class="barra" id="reserva"><ReservaBarra /></div>
  </section>
</Proto>
<style is:global>
  body { font-family: 'Jost Variable', system-ui, sans-serif; background: #050912; color: #f3ead8; }
</style>
<style>
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; --rb-bg: rgb(10 16 28 / .55); --rb-fg: #f3ead8; --rb-linha: rgb(243 234 216 / .28); --rb-btn-bg: #ffd58a; --rb-btn-fg: #101827; --rb-blur: blur(14px); --rb-borda: 1px solid rgb(243 234 216 / .22); --rb-scheme: dark; --rb-fonte: 'Jost Variable', sans-serif; }
  .bg { position: absolute; inset: 0; }
  .veu { position: absolute; inset: 0; background: linear-gradient(to right, rgb(5 9 18 / .6), rgb(5 9 18 / .25) 55%, transparent 80%), linear-gradient(to bottom, rgb(5 9 18 / .5), transparent 25%, transparent 50%, rgb(5 9 18 / .6)); }
  .nav { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; padding: 1.5rem clamp(1.25rem, 4vw, 3.5rem); }
  .marca { font-size: 1.3rem; font-weight: 500; letter-spacing: .42em; text-transform: uppercase; text-decoration: none; }
  .nav nav { display: flex; gap: 2rem; align-items: center; } .nav a { text-decoration: none; font-size: .78rem; letter-spacing: .22em; text-transform: uppercase; padding: .6rem 0; }
  .cta { border: 1px solid #ffd58a; padding: .7rem 1.4rem !important; color: #ffd58a; }
  .conteudo { position: relative; z-index: 2; align-self: center; padding: 0 clamp(1.25rem, 4vw, 3.5rem); margin-top: -4vh; }
  .hora { margin: 0 0 1.25rem; font-size: .85rem; letter-spacing: .22em; text-transform: uppercase; color: #ffd58a; }
  .hora::before { content: ''; display: inline-block; width: .5rem; height: .5rem; border-radius: 50%; background: #ffd58a; margin-right: .75rem; box-shadow: 0 0 14px 2px #ffd58a; animation: pulsa 3.2s ease-in-out infinite; }
  @keyframes pulsa { 50% { opacity: .45; } }
  h1 { margin: 0 0 1.25rem; font-weight: 200; font-size: clamp(3rem, 1rem + 8vw, 8.4rem); line-height: .98; letter-spacing: -.02em; max-width: 11ch; text-wrap: balance; }
  .sub { margin: 0; font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); font-weight: 300; max-width: 24ch; }
  .barra { position: relative; z-index: 2; padding: 0 clamp(1.25rem, 4vw, 3.5rem) clamp(1.25rem, 3vw, 2.5rem); }
  @media (max-width: 52rem) { .nav nav a:not(.cta) { display: none; } }
</style>
