---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada · Hotel Winner" temReserva={false}>
  <section class="section">
    <div class="container nf">
      <span class="filete" aria-hidden="true"></span>
      <h1>Página não encontrada</h1>
      <p class="lead">O endereço pode ter mudado ou ter sido digitado errado. Siga por um destes caminhos:</p>
      <div class="nf__acoes"><a class="btn" href="/">Voltar ao início</a><a class="btn btn--linha" href="/acomodacoes/">Ver as acomodações</a></div>
    </div>
  </section>
</Base>
<style>
  .nf { display: grid; gap: 1.75rem; justify-items: start; min-height: 52vh; align-content: center; }
  .nf .lead { margin: 0; max-width: 46ch; }
  .nf__acoes { display: flex; flex-wrap: wrap; gap: 1rem; }
</style>
