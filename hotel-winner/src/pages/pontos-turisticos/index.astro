---
import Base from '../../layouts/Base.astro';
import { hotel, pontosTuristicos } from '../../data/hotel';
const mapa = (n: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(n + ' Barretos SP')}`;
---
<Base title="Pontos turísticos · Hotel Winner" description="Região dos Lagos, Parque do Peão, Estação Cultura e o Museu Histórico, Artístico e Folclórico Rui Menezes: pontos turísticos de Barretos perto do Hotel Winner. Projeto conceitual.">
  <section class="section topo" aria-labelledby="h-p">
    <div class="container topo__g">
      <h1 id="h-p">Pontos turísticos</h1>
      <p class="lead">Região dos Lagos, Parque do Peão, Estação Cultura e o Museu Histórico, Artístico e Folclórico “Rui Menezes” estão entre os pontos turísticos de Barretos.</p>
    </div>
  </section>

  <section class="section sec--champ lista-sec" aria-labelledby="h-l">
    <div class="container">
      <h2 id="h-l" class="sr-only">Lista de pontos turísticos</h2>
      <ol class="pts num">
        {pontosTuristicos.map((p, i) => (
          <li>
            <span class="pts__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="pts__nome">{p.nome}</h3>
            <p class="pts__d">{p.distancia || 'Distância a confirmar com o hotel'}</p>
            <a class="link-ouro" href={mapa(p.nome)} target="_blank" rel="noopener">Ver no mapa<span class="sr-only"> ({p.nome}, abre em nova aba)</span></a>
          </li>
        ))}
      </ol>
      <p class="sec-txt nota">Os quatro primeiros nomes vêm da página de pontos turísticos do site do hotel; a Catedral e as distâncias vêm do documento de conteúdo do projeto. Fotos dos pontos turísticos serão incluídas quando houver imagens com autorização de uso.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="h-c">
    <div class="container cta">
      <div>
        <h2 id="h-c">Hospede-se perto de tudo isso.</h2>
        <p class="lead">O {hotel.nome} fica na {hotel.enderecoCompleto}.</p>
      </div>
      <div class="cta__acoes">
        <a class="btn" href={hotel.telefoneLink}>Ligar para o hotel</a>
        <a class="btn btn--linha" href="/acomodacoes/">Ver os apartamentos</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .topo { padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .topo__g { display: grid; gap: 1.5rem; }
  .topo__g .lead { margin: 0; max-width: 46ch; }
  @media (min-width: 62rem) { .topo__g { grid-template-columns: 1fr 1fr; align-items: end; gap: 6rem; } }
  .lista-sec { padding-block: clamp(3rem, 6vw, 5rem); }
  .pts { display: grid; border-top: 3px solid var(--ouro); }
  .pts li { display: grid; gap: .35rem .5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--areia); align-items: baseline; }
  .pts__n { font: 500 .8rem var(--f-texto); letter-spacing: .15em; color: var(--ouro-texto); }
  .pts__nome { font: 400 clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem)/1.1 var(--f-titulo); letter-spacing: -.01em; }
  .pts__d { margin: 0; color: var(--marrom); }
  @media (min-width: 62rem) {
    .pts li { grid-template-columns: 4rem 1fr 14rem 9rem; gap: 2rem; padding: 2rem 0; }
    .pts__d { text-align: right; }
  }
  .nota { margin: 2rem 0 0; font-size: .9rem; max-width: 70ch; }
  .cta { display: grid; gap: 2rem; align-items: end; }
  .cta .lead { margin: 1rem 0 0; }
  .cta__acoes { display: flex; flex-wrap: wrap; gap: .9rem; }
  @media (min-width: 62rem) { .cta { grid-template-columns: 1.2fr .8fr; gap: 6rem; } }
</style>
