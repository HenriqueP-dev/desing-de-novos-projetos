---
import Logo from './Logo.astro';
interface Props { sobre?: boolean }
const { sobre = false } = Astro.props;
const esq = [{ href: '/quartos/', t: 'Quartos' }, { href: '/#experiencias', t: 'Experiências' }];
const dir = [{ href: '/#direto', t: 'Reserva direta' }, { href: '/contato/', t: 'Contato' }];
---
<header class={`hd ${sobre ? 'hd--sobre' : 'hd--solido'}`}>
  <div class="hd__in">
    <nav class="hd__l tracado" aria-label="Principal">{esq.map((l) => <a href={l.href}>{l.t}</a>)}</nav>
    <a href="/" class="hd__logo"><Logo /></a>
    <div class="hd__r">
      <nav class="tracado hd__links" aria-label="Secundário">{dir.map((l) => <a href={l.href}>{l.t}</a>)}</nav>
      <a class="hd__cta tracado" href="#reserva">Reservar</a>
      <button class="hd__menu tracado" type="button" aria-expanded="false" aria-controls="painel">Menu</button>
    </div>
  </div>
  <div id="painel" class="hd__painel" hidden>
    <nav aria-label="Menu">
      {[...esq, ...dir].map((l) => <a href={l.href}>{l.t}</a>)}
      <a href="#reserva">Reservar</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.hd__menu')!;
  const painel = document.getElementById('painel')!;
  function abrir(o: boolean) { btn.setAttribute('aria-expanded', String(o)); btn.textContent = o ? 'Fechar' : 'Menu'; painel.hidden = !o; document.body.style.overflow = o ? 'hidden' : ''; }
  btn.addEventListener('click', () => abrir(btn.getAttribute('aria-expanded') !== 'true'));
  painel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => abrir(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !painel.hidden) { abrir(false); btn.focus(); } });
</script>
<style>
  .hd { position: relative; z-index: 30; height: var(--hd-h); }
  .hd--solido { background: #fff; border-bottom: 1px solid var(--nevoa-2); }
  .hd__in { height: 100%; width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .hd a, .hd__menu { text-decoration: none; padding: .6rem 0; }
  .hd__l { display: flex; gap: 2rem; }
  .hd__r { display: flex; justify-content: flex-end; align-items: center; gap: 2rem; }
  .hd__links { display: flex; gap: 2rem; }
  .hd__cta { border: 1px solid currentColor; padding: .75rem 1.4rem !important; }
  .hd__menu { display: none; background: none; border: 0; color: inherit; font-family: inherit; cursor: pointer; min-height: 2.75rem; }
  @media (hover: hover) { .hd__l a:hover, .hd__links a:hover { opacity: .6; } .hd__cta:hover { background: var(--tinta); color: #fff; border-color: var(--tinta); } }
  .hd__painel { position: fixed; inset: 0; z-index: 25; background: #fff; padding: calc(var(--hd-h) + 2rem) var(--gutter) 2rem; overflow: auto; }
  .hd__painel[hidden] { display: none; }
  .hd__painel nav { display: grid; }
  .hd__painel a { font-size: clamp(2rem, 8vw, 3rem); font-weight: 250; letter-spacing: -.01em; text-transform: none; padding: .9rem 0; border-bottom: 1px solid var(--nevoa-2); text-decoration: none; }
  .hd__menu { position: relative; z-index: 40; }
  @media (max-width: 62rem) {
    .hd__in { grid-template-columns: 1fr auto; } .hd__l, .hd__links, .hd__cta { display: none; } .hd__logo { grid-column: 1; grid-row: 1; justify-self: start; }
    .hd__r { grid-column: 2; grid-row: 1; } .hd__menu { display: block; }
  }
  @media (min-width: 62.01rem) { .hd__painel { display: none !important; } }
</style>
