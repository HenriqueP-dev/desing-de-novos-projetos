---
import Logo from './Logo.astro';
const links = [
  { href: '#quartos', t: 'Quartos' },
  { href: '#direto', t: 'Reserva direta' },
  { href: '#motivo', t: 'Para quem vem' },
  { href: '#contato', t: 'Contato' },
];
---
<header class="hd">
  <div class="hd__in container">
    <a href="/" class="hd__logo"><Logo /></a>
    <button class="hd__toggle" aria-expanded="false" aria-controls="menu" type="button">
      <span class="sr-only">Menu</span><span class="hd__bars" aria-hidden="true"></span>
    </button>
    <nav id="menu" class="hd__nav" aria-label="Principal">
      <ul>{links.map((l) => <li><a href={l.href}>{l.t}</a></li>)}</ul>
      <a class="btn btn--acao hd__cta" href="#reserva">Pedir reserva</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.hd__toggle');
  const nav = document.getElementById('menu');
  const set = (open: boolean) => { btn?.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open); };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
<style>
  .hd { position: sticky; top: 0; z-index: 50; background: var(--cal); border-bottom: 2px solid var(--asfalto); }
  .hd__in { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; }
  .hd__logo { text-decoration: none; }
  .hd__nav { display: flex; align-items: center; gap: 2.5rem; }
  .hd__nav ul { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .hd__nav li a { text-decoration: none; font-weight: 700; padding-block: .5rem; border-bottom: 3px solid transparent; transition: border-color .2s; }
  @media (hover: hover) { .hd__nav li a:hover { border-color: var(--amarelo); } }
  .hd__cta { min-height: 2.75rem; padding: .55rem 1.25rem; }
  .hd__toggle { display: none; width: 2.75rem; height: 2.75rem; border: 2px solid var(--asfalto); border-radius: var(--r-ctrl); background: transparent; cursor: pointer; position: relative; }
  .hd__bars, .hd__bars::before { position: absolute; left: 50%; width: 1.2rem; height: 2px; background: var(--asfalto); transform: translateX(-50%); transition: transform .25s var(--ease); }
  .hd__bars { top: calc(50% - 4px); } .hd__bars::before { content: ''; top: 8px; }
  .hd__toggle[aria-expanded='true'] .hd__bars { transform: translateX(-50%) translateY(4px) rotate(45deg); }
  .hd__toggle[aria-expanded='true'] .hd__bars::before { transform: translateX(-50%) translateY(-8px) rotate(-90deg); }
  @media (max-width: 52rem) {
    .hd__toggle { display: block; }
    .hd__nav { position: absolute; inset: 100% 0 auto 0; flex-direction: column; align-items: stretch; gap: 1.5rem; padding: 1.25rem var(--gutter) 2rem; background: var(--cal); border-bottom: 2px solid var(--asfalto); clip-path: inset(0 0 100% 0); visibility: hidden; transition: clip-path .4s var(--ease), visibility 0s .4s; }
    .hd__nav.is-open { clip-path: inset(0); visibility: visible; transition: clip-path .4s var(--ease); }
    .hd__nav ul { flex-direction: column; gap: 0; }
    .hd__nav li a { display: block; font: 700 2.2rem/1.4 var(--f-sinal); text-transform: uppercase; border: 0; }
  }
</style>
