---
import Logo from './Logo.astro';
const links = [
  { href: '#quartos', t: 'Quartos' },
  { href: '#direto', t: 'Reserva direta' },
  { href: '#chegar', t: 'Barretos' },
  { href: '#contato', t: 'Contato' },
];
---
<header class="hd">
  <div class="hd__in container">
    <a href="/" class="hd__logo" aria-label="Hotel Winner, página inicial"><Logo /></a>
    <button class="hd__toggle" aria-expanded="false" aria-controls="menu" type="button">
      <span class="sr-only">Abrir menu</span>
      <span class="hd__bars" aria-hidden="true"></span>
    </button>
    <nav id="menu" class="hd__nav" aria-label="Principal">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.t}</a></li>)}
      </ul>
      <a class="btn btn--primary hd__cta" href="#reserva">Reservar</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.hd__toggle');
  const nav = document.getElementById('menu');
  const set = (open: boolean) => { btn?.setAttribute('aria-expanded', String(open)); nav?.classList.toggle('is-open', open); };
  btn?.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
</script>
<style>
  .hd { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--areia-100) 82%, transparent); backdrop-filter: blur(14px) saturate(1.3); border-bottom: 1px solid color-mix(in srgb, var(--tinta-900) 8%, transparent); }
  .hd__in { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; }
  .hd__logo { text-decoration: none; }
  .hd__nav ul { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  .hd__nav { display: flex; align-items: center; gap: 2.5rem; }
  .hd__nav li a { text-decoration: none; font-weight: 600; font-size: .95rem; position: relative; padding-block: .4rem; }
  .hd__nav li a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: var(--brasa-500); transform: scaleX(0); transform-origin: left; transition: transform .35s var(--ease); }
  .hd__nav li a:hover::after { transform: scaleX(1); }
  .hd__cta { min-height: 2.75rem; padding: .6rem 1.3rem; }
  .hd__toggle { display: none; width: 2.75rem; height: 2.75rem; border: 1.5px solid var(--tinta-900); border-radius: 50%; background: transparent; cursor: pointer; position: relative; }
  .hd__bars, .hd__bars::before { position: absolute; left: 50%; width: 1.1rem; height: 1.5px; background: var(--tinta-900); transform: translateX(-50%); transition: transform .3s var(--ease); }
  .hd__bars { top: calc(50% - 3px); } .hd__bars::before { content: ''; top: 6px; left: 50%; }
  .hd__toggle[aria-expanded='true'] .hd__bars { transform: translateX(-50%) translateY(3px) rotate(45deg); }
  .hd__toggle[aria-expanded='true'] .hd__bars::before { transform: translateX(-50%) translateY(-6px) rotate(-90deg); }

  @media (max-width: 52rem) {
    .hd__toggle { display: block; }
    .hd__nav { position: absolute; inset: 100% 0 auto 0; flex-direction: column; align-items: stretch; gap: 1.5rem; padding: 1.5rem var(--gutter) 2rem; background: var(--areia-100); border-bottom: 1px solid var(--areia-300); clip-path: inset(0 0 100% 0); visibility: hidden; transition: clip-path .5s var(--ease), visibility 0s .5s; }
    .hd__nav.is-open { clip-path: inset(0); visibility: visible; transition: clip-path .5s var(--ease); }
    .hd__nav ul { flex-direction: column; gap: .25rem; }
    .hd__nav li a { display: block; font: 400 1.9rem/1.3 var(--f-display); padding-block: .35rem; }
    .hd__nav li a::after { display: none; }
  }
</style>
