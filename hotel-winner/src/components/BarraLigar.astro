---
// No celular, ligar é a ação mais natural e o telefone é o único canal confirmado:
// fica fixo no rodapé da tela, sempre ao alcance do polegar. No desktop não aparece.
import { hotel, textos } from '../conteudo/ativo';
---
<a class="ligar" href={hotel.telefoneLink}>
  <span class="ligar__t">{textos.hero.ligar}</span>
  <span class="ligar__n num">{hotel.telefone}</span>
</a>
<style>
  .ligar { display: none; }
  @media (max-width: 62rem) {
    .ligar { position: fixed; z-index: 20; inset: auto 0 0 0; display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      min-height: 3.5rem; padding: .6rem var(--gutter) calc(.6rem + env(safe-area-inset-bottom));
      background: var(--grafite); color: var(--off); text-decoration: none; }
    .ligar__t { font: 500 var(--t-mini)/1 var(--f-texto); letter-spacing: .18em; text-transform: uppercase; }
    .ligar__n { font: 400 1.1rem/1 var(--f-titulo); }
  }
</style>
