---
/**
 * Espaço de foto. Com `foto`, mostra a foto real. Sem `foto`, mostra um espaço reservado
 * assumido como tal (moldura dourada fina + legenda), em vez de inventar uma imagem.
 * Para trocar: passe foto="/fotos/arquivo.jpg" (arquivo em public/fotos/) e um alt descritivo.
 */
interface Props { rotulo: string; foto?: string; alt?: string; proporcao?: string; class?: string; aviso?: string }
const { rotulo, foto, alt = '', proporcao = '4 / 5', class: cls, aviso = 'Espaço reservado para a foto oficial' } = Astro.props;
---
<figure class:list={['fs', cls]} style={`aspect-ratio:${proporcao}`} data-revelar-foto>
  {foto
    ? <img src={foto} alt={alt} loading="lazy" decoding="async" data-parallax />
    : <div class="fs__vazio"><span class="fs__t">{rotulo}</span><span class="fs__s">{aviso}</span></div>}
</figure>
<style>
  .fs { position: relative; margin: 0; overflow: hidden; background: var(--areia); border-radius: var(--raio); }
  .fs img { width: 100%; height: 110%; object-fit: cover; }
  .fs__vazio { position: absolute; inset: 0; display: grid; place-content: center; gap: .6rem; text-align: center; padding: 2rem;
    background: linear-gradient(180deg, var(--champ), var(--areia)); }
  .fs__vazio::before { content: ''; position: absolute; inset: 14px; border: 1px solid var(--ouro); border-radius: 1px; pointer-events: none; }
  .fs__t { font: 400 clamp(1.3rem, 1.1rem + .8vw, 1.75rem)/1.15 var(--f-titulo); color: var(--grafite); }
  .fs__s { font-size: .82rem; letter-spacing: .04em; color: var(--grafite); }
</style>
