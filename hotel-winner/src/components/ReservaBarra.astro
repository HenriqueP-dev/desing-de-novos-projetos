---
// Barra de reserva dos protótipos (visual apenas). Cores vêm de variáveis CSS da página que a usa.
---
<form class="rb" novalidate aria-label="Pedido de reserva">
  <label class="rb__c"><span>Chegada</span><input type="date" name="in" /></label>
  <label class="rb__c"><span>Saída</span><input type="date" name="out" /></label>
  <label class="rb__c"><span>Hóspedes</span>
    <select name="g"><option>1</option><option selected>2</option><option>3</option><option>4</option></select>
  </label>
  <button class="rb__ok" type="submit">Reservar</button>
  <p class="rb__nota">Check-in até meia-noite · <span data-agora>agora em Barretos</span></p>
</form>
<script>
  const f = new Intl.DateTimeFormat('pt-BR', { timeZone: 'America/Sao_Paulo', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
  const t = () => document.querySelectorAll<HTMLElement>('[data-agora]').forEach((e) => (e.textContent = `agora ${f.format(new Date())} em Barretos`));
  t(); setInterval(t, 20000);
  document.querySelectorAll('.rb').forEach((x) => x.addEventListener('submit', (e) => e.preventDefault()));
</script>
<style>
  .rb { display: grid; grid-template-columns: 1fr 1fr; gap: .25rem 0; align-items: end; background: var(--rb-bg); color: var(--rb-fg); border: var(--rb-borda, 0); backdrop-filter: var(--rb-blur, none); padding: 1rem 1.25rem .5rem; font-family: var(--rb-fonte); }
  .rb__c { display: grid; gap: .3rem; padding: .35rem .6rem; border-right: 1px solid var(--rb-linha); min-width: 0; }
  .rb__c:nth-child(2n) { border-right: 0; }
  .rb__c span { font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; opacity: .75; }
  .rb__c input, .rb__c select { appearance: none; background: transparent; border: 0; border-bottom: 1px solid var(--rb-linha); color: inherit; font: inherit; font-size: 1rem; padding: .4rem 0; min-height: 2.75rem; width: 100%; color-scheme: var(--rb-scheme, light); }
  .rb__ok { grid-column: 1 / -1; margin: .75rem 0; min-height: 3.25rem; border: 0; cursor: pointer; background: var(--rb-btn-bg); color: var(--rb-btn-fg); font: inherit; font-size: .8rem; letter-spacing: .22em; text-transform: uppercase; }
  .rb__nota { grid-column: 1 / -1; margin: 0 0 .5rem; font-size: .85rem; opacity: .8; }
  @media (min-width: 62rem) {
    .rb { grid-template-columns: repeat(3, 1fr) auto; padding: .75rem 1rem .75rem 1.25rem; gap: 0; }
    .rb__c:nth-child(2n) { border-right: 1px solid var(--rb-linha); } .rb__c:nth-child(3) { border-right: 0; }
    .rb__ok { grid-column: auto; margin: 0 0 0 1rem; padding-inline: 2.5rem; }
    .rb__nota { grid-column: 1 / -1; margin: .6rem 0 0; padding-left: .6rem; }
  }
</style>
