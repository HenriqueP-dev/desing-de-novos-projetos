---
import Logo from './Logo.astro';
import { hotel } from '../data/hotel';
---
<footer class="ft escuro">
  <div class="container ft__in">
    <div class="ft__logo"><Logo /></div>
    <p class="ft__nota">Projeto conceitual de design e desenvolvimento. Textos, preços e imagens são ilustrativos e não representam o {hotel.nome} real. Horários vieram de listagens públicas e precisam de confirmação com o hotel.</p>
  </div>
</footer>
<style>
  .ft { background: var(--asfalto); color: var(--cal); padding-block: 3rem; border-top: 6px solid var(--amarelo); }
  .ft__in { display: grid; gap: 1.5rem; }
  .ft__logo { color: #fff; } .ft :global(.logo__loc) { color: var(--cal-2); }
  .ft__nota { margin: 0; font-size: .9rem; color: var(--cal-2); max-width: 60ch; }
  @media (min-width: 52rem) { .ft__in { grid-template-columns: auto 1fr; gap: 4rem; align-items: center; } }
</style>
