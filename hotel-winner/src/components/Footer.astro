---
import Logo from './Logo.astro';
import { hotel } from '../data/hotel';
---
<footer class="ft">
  <div class="container ft__in">
    <div class="ft__logo"><Logo /></div>
    <address class="ft__dados">
      <p>{hotel.endereco}</p>
      <p>{hotel.telefone}<br />{hotel.email}</p>
    </address>
    <p class="ft__nota">Projeto conceitual de design e desenvolvimento. Textos, preços e imagens são ilustrativos e não representam o {hotel.nome} real. Os horários vieram de listagens públicas e precisam de confirmação com o hotel.</p>
  </div>
</footer>
<style>
  .ft { background: var(--nevoa); padding-block: 4rem; }
  .ft__in { display: grid; gap: 2.5rem; align-items: start; }
  .ft__logo { justify-self: start; } .ft__logo :global(.logo) { justify-items: start; }
  .ft__dados { font-style: normal; } .ft__dados p { margin: 0 0 1rem; }
  .ft__nota { margin: 0; font-size: .9rem; color: var(--tinta-2); max-width: 48ch; }
  @media (min-width: 62rem) { .ft__in { grid-template-columns: 1fr 1fr 1.3fr; gap: 4rem; } }
</style>
