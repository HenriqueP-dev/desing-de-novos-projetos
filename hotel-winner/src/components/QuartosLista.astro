---
import { quartos } from '../data/hotel';
---
<div class="qs">
  <div class="qs__cab" aria-hidden="true"><span>Quarto</span><span>Hóspedes</span><span>Cama</span><span></span></div>
  {quartos.map((q) => (
    <details class="q" name="quartos">
      <summary>
        <span class="q__nome">{q.nome}</span>
        <span class="q__meta"><span class="q__k">Hóspedes</span>Até {q.max}</span>
        <span class="q__meta"><span class="q__k">Cama</span>{q.cama}</span>
        <span class="q__icone" aria-hidden="true"></span>
      </summary>
      <div class="q__corpo">
        <p class="q__resumo">{q.resumo}</p>
        <ul>{q.itens.map((i) => <li>{i}</li>)}</ul>
        <div class="q__acao">
          <a class="btn btn--acao" href="#reserva" data-pedir={q.id}>Pedir o quarto {q.nome}</a>
          <p class="rotulo">Valor e fotos a definir com o hotel.</p>
        </div>
      </div>
    </details>
  ))}
</div>
<style>
  .qs { border-bottom: 3px solid var(--asfalto); }
  .qs__cab { display: none; }
  .q { border-top: 3px solid var(--asfalto); }
  summary { list-style: none; display: grid; grid-template-columns: 1fr auto; gap: .35rem 1rem; align-items: center; padding: 1.4rem .5rem; cursor: pointer; transition: background-color .2s; }
  summary::-webkit-details-marker { display: none; }
  @media (hover: hover) { summary:hover { background: var(--cal-2); } }
  .q__nome { font: 700 var(--t-h3)/1 var(--f-sinal); text-transform: uppercase; grid-column: 1; }
  .q__meta { grid-column: 1; font-weight: 700; }
  .q__k { display: inline-block; min-width: 5.5rem; font-weight: 400; color: var(--texto-2); }
  .q__icone { grid-column: 2; grid-row: 1 / span 3; position: relative; width: 2.5rem; height: 2.5rem; border: 3px solid var(--asfalto); border-radius: var(--r-ctrl); flex: none; }
  .q__icone::before, .q__icone::after { content: ''; position: absolute; left: 50%; top: 50%; width: 1rem; height: 3px; background: var(--asfalto); transform: translate(-50%, -50%); transition: transform .3s var(--ease); }
  .q__icone::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .q__icone { background: var(--amarelo); }
  details[open] .q__icone::after { transform: translate(-50%, -50%) rotate(0); }
  details[open] summary { background: var(--cal-2); }
  .q__corpo { display: grid; gap: 1.25rem; padding: 1.5rem .5rem 2.25rem; background: var(--cal-2); }
  .q__resumo { margin: 0; font-size: var(--t-lead); max-width: 40ch; }
  .q__corpo ul { margin: 0; padding: 0; list-style: none; display: grid; gap: .4rem; }
  .q__corpo li { padding-left: 1.4rem; position: relative; }
  .q__corpo li::before { content: ''; position: absolute; left: 0; top: .7em; width: .7rem; height: 3px; background: var(--asfalto); }
  .q__acao { display: grid; gap: .6rem; justify-items: start; }
  .q__acao .rotulo { margin: 0; }
  @media (min-width: 52rem) {
    .qs__cab { display: grid; grid-template-columns: 1.3fr 1fr 1.4fr 2.5rem; gap: 1rem; padding: 0 .5rem .6rem; font-weight: 700; color: var(--texto-2); font-size: .9rem; }
    summary { grid-template-columns: 1.3fr 1fr 1.4fr 2.5rem; gap: 1rem; }
    .q__nome, .q__meta, .q__icone { grid-column: auto; grid-row: auto; }
    .q__k { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .q__corpo { grid-template-columns: 1.3fr 1fr 1.4fr 2.5rem; gap: 1rem; align-items: start; }
    .q__resumo { grid-column: 1; } .q__corpo ul { grid-column: 2 / span 2; } .q__acao { grid-column: 1 / span 3; grid-row: 2; display: flex; align-items: center; gap: 1.25rem; }
  }
</style>
