---
// Quarto ilustrado: parede clara, janela com feixe de luz, cama. Três variantes de mobília.
interface Props { variante?: 'standard' | 'superior' | 'familia' }
const { variante = 'standard' } = Astro.props;
const id = `q-${variante}`;
---
<svg class="cena" viewBox="0 0 1200 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-p`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f6f9fa"/><stop offset="1" stop-color="#dfe7ec"/></linearGradient>
    <linearGradient id={`${id}-c`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".75"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
    <linearGradient id={`${id}-f`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#c9d5dc"/><stop offset="1" stop-color="#aebdc6"/></linearGradient>
  </defs>
  <rect width="1200" height="900" fill={`url(#${id}-p)`}/>
  <rect y="640" width="1200" height="260" fill={`url(#${id}-f)`}/>
  <rect y="636" width="1200" height="8" fill="#fff" opacity=".6"/>
  <!-- janela e feixe de luz -->
  <polygon points="780,150 1060,150 1010,900 520,900" fill={`url(#${id}-c)`} opacity=".7"/>
  <rect x="780" y="130" width="290" height="400" fill="#cfe0ea" stroke="#fff" stroke-width="12"/>
  <path d="M925 130V530M780 330H1070" stroke="#fff" stroke-width="8"/>
  <rect x="790" y="140" width="130" height="190" fill="#e7f0f5" opacity=".7"/>
  <!-- cama principal -->
  {variante === 'familia'
    ? (<g>
        <rect x="70" y="350" width="430" height="150" fill="#9fb3be"/>
        <rect x="70" y="470" width="430" height="190" fill="#fff"/><rect x="70" y="520" width="430" height="140" fill="#c7d5dc"/>
        <rect x="110" y="440" width="150" height="56" rx="8" fill="#fff"/><rect x="290" y="440" width="150" height="56" rx="8" fill="#fff"/>
        <rect x="560" y="440" width="260" height="130" fill="#9fb3be"/>
        <rect x="560" y="520" width="260" height="140" fill="#fff"/><rect x="560" y="560" width="260" height="100" fill="#dbe5ea"/>
        <rect x="590" y="500" width="110" height="46" rx="8" fill="#fff"/>
      </g>)
    : (<g>
        <rect x={variante === 'superior' ? 110 : 190} y="330" width={variante === 'superior' ? 560 : 470} height="180" fill="#9fb3be"/>
        <rect x={variante === 'superior' ? 110 : 190} y="480" width={variante === 'superior' ? 560 : 470} height="190" fill="#fff"/>
        <rect x={variante === 'superior' ? 110 : 190} y="535" width={variante === 'superior' ? 560 : 470} height="135" fill="#c7d5dc"/>
        <rect x={variante === 'superior' ? 170 : 240} y="448" width="160" height="58" rx="8" fill="#fff"/>
        <rect x={variante === 'superior' ? 400 : 440} y="448" width="160" height="58" rx="8" fill="#fff"/>
      </g>)}
  {variante === 'superior' && (<g>
    <rect x="860" y="560" width="190" height="110" rx="14" fill="#8ba3b0"/><rect x="880" y="520" width="150" height="70" rx="12" fill="#9fb4c0"/>
    <rect x="1030" y="610" width="14" height="80" fill="#6f8c9b"/><rect x="866" y="665" width="12" height="40" fill="#6f8c9b"/>
  </g>)}
  <!-- criado-mudo e abajur -->
  <rect x={variante === 'familia' ? 850 : 705} y="560" width="90" height="100" fill="#e9eff2"/>
  <rect x={variante === 'familia' ? 889 : 744} y="500" width="12" height="62" fill="#6f8c9b"/><ellipse cx={variante === 'familia' ? 895 : 750} cy="498" rx="36" ry="22" fill="#fff"/>
</svg>
