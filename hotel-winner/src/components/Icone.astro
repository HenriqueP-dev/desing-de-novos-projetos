  'Acessibilidade': '<circle cx="12" cy="12" r="9.3"/><circle cx="12" cy="7.2" r="1.15"/><path d="M7.3 10.1h9.4M12 10.1v4.2l-2.6 4.4M12 14.3l2.6 4.4"/>',
