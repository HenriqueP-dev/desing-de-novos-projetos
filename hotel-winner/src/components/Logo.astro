---
// Marca tipográfica: nome em Bodoni, filete dourado e cidade espaçada.
---
<span class="logo">
  <span class="logo__n">Hotel Winner</span>
  <span class="logo__l"><span class="logo__f" aria-hidden="true"></span>Barretos<span class="logo__f" aria-hidden="true"></span></span>
</span>
<style>
  .logo { display: inline-grid; justify-items: center; gap: .3rem; line-height: 1; color: var(--grafite); }
  .logo__n { font: 400 1.45rem/1 var(--f-titulo); letter-spacing: .01em; }
  .logo__l { display: inline-flex; align-items: center; gap: .55rem; font: 500 .58rem/1 var(--f-texto); letter-spacing: .42em; text-transform: uppercase; padding-left: .42em; color: var(--marrom); }
  .logo__f { width: .9rem; height: 1px; background: var(--ouro); }
</style>
