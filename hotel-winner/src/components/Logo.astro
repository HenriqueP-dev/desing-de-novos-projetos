---
// Marca: placa amarela com "W", como um marcador de quilômetro.
---
<span class="logo">
  <span class="logo__w" aria-hidden="true">W</span>
  <span class="logo__txt"><span class="logo__nome">Hotel Winner</span><span class="logo__loc">Barretos, SP</span></span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: .75rem; }
  .logo__w { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; background: var(--amarelo); color: var(--asfalto); border-radius: .55rem; font: 800 1.9rem/1 var(--f-sinal); box-shadow: inset 0 0 0 2px var(--asfalto); }
  .logo__txt { display: grid; line-height: 1; }
  .logo__nome { font: 800 1.6rem/.9 var(--f-sinal); text-transform: uppercase; letter-spacing: .02em; }
  .logo__loc { font-size: .8rem; font-weight: 700; color: var(--texto-2); margin-top: .25rem; }
</style>
